# Copy to .env and export, or set inline: `ANTHROPIC_API_KEY=... npm start`
# (The server reads process environment variables; it does not load .env files itself.)

PORT=3000
DATABASE_PATH=data/lld.db

# Real AI review from Claude. Leave unset to run with structural checks only.
# ANTHROPIC_API_KEY=sk-ant-...
# LLD_AI_MODEL=claude-opus-5

# auto | anthropic | demo | off.  `demo` needs no key and is clearly labelled as a stand-in.
# LLD_AI_PROVIDER=demo
# LLD_DEMO_MODE=ok          # ok | slow | fail | flaky | garbage  (demo provider only)

LLD_AI_TIMEOUT_MS=120000
LLD_AI_MAX_ATTEMPTS=2
LLD_WORKER_CONCURRENCY=2
